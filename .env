# 项目部署目录路径
# 参考 https://cn.vitejs.dev/config/shared-options.html#base
VITE_APP_BASE_PATH=/

# 开发服务器端口
VITE_APP_PORT=9521

# 构建输出目录
VITE_APP_DIST_NAME=dist/admin

# 项目标题
VITE_APP_TITLE=博客管理系统
